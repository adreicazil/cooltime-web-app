# Local Storage Directory Paths (Use forward slashes / for PHP compatibility)
OTP_STORAGE_DIR=C:/secure/cooltime-otp
FEEDBACK_STORAGE_DIR=C:/secure/cooltime-feedback

# PayMongo Payment Gateway Credentials
PAYMONGO_PUBLIC_KEY=pk_test_replace_me
