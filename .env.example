# Copy this file to .env and replace every placeholder. Do not commit .env or
# put email provider credentials in browser code, HTML, or public files.
APP_URL=https://cooltimeautoaircon.online
API_BASE_URL=https://cooltimeautoaircon.online/api
# FIREBASE_API_KEY is required by the login OTP endpoint to validate Firebase ID tokens.
FIREBASE_API_KEY=your_firebase_web_api_key
# Resend REST API credentials used for sign-in and password-reset OTP emails.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="CoolTime Auto Aircon <noreply@cooltimeautoaircon.online>"
# Keep firebase-credentials.json in the project root for local development and never commit it. In production, use a protected path outside the web root.
# Required for server-only Firebase Auth and Firestore access. Store this JSON file
# outside the public web root and grant its service account Firebase Auth user
# management plus the Firestore data access required by the server API endpoints.
FIREBASE_CREDENTIALS="firebase-credentials.json"
SYSTEM_EMAIL_ADDRESS=support@cooltimeautoaircon.online
# Generate a long random value and invoke api/notification-scheduler.php with it.
NOTIFICATION_CRON_TOKEN=replace_with_a_random_secret
# Recommended in production: an absolute folder outside the web root, writable by PHP.
OTP_STORAGE_DIR=C:\secure\cooltime-otp
# Optional private path for uploaded feedback attachments; defaults to the OS temp directory.
FEEDBACK_STORAGE_DIR=C:\secure\cooltime-feedback
# Server-only PayMongo credentials. Add these to the server's ignored .env file.
PAYMONGO_PUBLIC_KEY=pk_test_replace_me
PAYMONGO_SECRET_KEY=sk_test_replace_me
PAYMONGO_RETURN_URL=https://cooltimeautoaircon.online/customer-dashboard.html
# PayMongo webhook endpoint secret from Dashboard > Developers > Webhooks.
PAYMONGO_WEBHOOK_SECRET=whsk_replace_me
# Generate a private random token and have a trusted scheduler call
# api/expire-stale-checkouts.php every 5–10 minutes.
PAYMONGO_SWEEP_TOKEN=replace_with_a_long_random_secret
PAYMONGO_CHECKOUT_TIMEOUT_MINUTES=30
# Server-only Groq API key for the public FAQ chatbot. Never put this in browser code.
GROQ_API_KEY=your_groq_api_key
